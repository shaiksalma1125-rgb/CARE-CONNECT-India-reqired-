rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper primitives
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // User accounts collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      // Any signed-in user can read their own appointments
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid != null
      );
      // User can create appointment for themselves
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // User can update or cancel their own appointment
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
